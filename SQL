-- SQL ANALYSIS
SELECT
AVG(`Signal Strength (dBm)`) 
FROM signal_metrics;

SELECT
`Network Type`,
COUNT(*) as jumlah
FROM signal_metrics
group by `Network Type`;

SELECT 
Locality,
AVG(`Data Throughput (Mbps)`) as avg_speed
FROM signal_metrics
GROUP BY Locality
ORDER BY avg_speed;

SELECT
	CASE
		WHEN `Signal Strength (dBm)` >= -70 THEN 'Excellent'
        WHEN `Signal Strength (dBm)` >= -85 THEN 'Good'
        WHEN `Signal Strength (dBm)` >= -100 THEN 'Fair'
	ELSE 'Poor'
    End As signal_quality,
    COUNT(*) AS total
    FROM signal_metrics
    GROUP BY signal_quality;
    
    


